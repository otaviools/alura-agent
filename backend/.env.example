# Copie este arquivo para .env e preencha os valores reais.
# O .env nunca deve ser commitado (ver .gitignore).

# --- Credencial do servico de IA (obrigatoria) ---
# Chave da API do Google Gemini (obtida em https://aistudio.google.com/apikey).
# Valor abaixo e ficticio.
GOOGLE_API_KEY=AIza-chave-ficticia-troque-por-uma-real

# --- Servidor ---
DOCSY_HOST=127.0.0.1
DOCSY_PORTA=5000
DOCSY_DEBUG=false

# --- Modelo ---
# gemini-flash-lite-latest -> leve, maior cota no nivel gratuito (padrao).
# gemini-3.6-flash -> equilibrado. gemini-3.6-pro -> melhor qualidade.
DOCSY_MODELO=gemini-flash-lite-latest
DOCSY_MODELO_MAX_TOKENS=8000
DOCSY_TRECHOS_POR_BUSCA=6

# --- Limites de entrada ---
DOCSY_TAMANHO_MAXIMO_MB=20
DOCSY_PAGINAS_MAXIMAS=300
DOCSY_PERGUNTA_MAXIMA_CARACTERES=2000
DOCSY_MENSAGENS_MAXIMAS_HISTORICO=40

# --- Sessao em memoria ---
DOCSY_SESSAO_TTL_MINUTOS=60
DOCSY_SESSOES_MAXIMAS=200

# --- Limite de requisicoes por IP ---
DOCSY_LIMITE_PADRAO=240 per hour
DOCSY_LIMITE_SESSOES=60 per hour
DOCSY_LIMITE_UPLOAD=5 per minute;40 per hour
DOCSY_LIMITE_MENSAGENS=20 per minute;150 per hour

# --- Front-end ---
DOCSY_ORIGEM_PERMITIDA=http://localhost:3000
